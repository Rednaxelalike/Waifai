{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "waifai-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "-w",
        "@waifai/web",
        "--",
        "--host"
      ],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "waifai-server",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:server"
      ],
      "port": 8477
    }
  ]
}
