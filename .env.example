# Copy to .env and fill in. .env is gitignored; .env.example must never hold
# real credentials.
#
# Only ONT_PASS is genuinely required. Everything else has a working default.

# ---------------------------------------------------------------------------
# Router (Huawei EchoLife HG8145V5)
# ---------------------------------------------------------------------------

ONT_HOST=192.168.100.1
ONT_USER=root
ONT_PASS=

# The root account is restricted on this firmware family and often cannot read
# the optical page at all. If `npm run discover` reports no optical data, set
# these - the stock MTN credentials are usually telecomadmin / admintelecom.
# When set, these are tried first and root is the fallback.
ONT_ADMIN_USER=
ONT_ADMIN_PASS=

# ---------------------------------------------------------------------------
# Polling
# ---------------------------------------------------------------------------

# How often to log into the router. One session per tick, logged out after, so
# the household is never locked out of the router UI. Below ~30s is pointless:
# optical power does not move that fast.
ONT_POLL_SEC=60

# The reachability sweep. This is what sets the resolution of outage
# detection - a 20s sweep can pin an outage to within 20 seconds.
PROBE_SEC=20

# A blackholed target costs PROBE_COUNT x PROBE_TIMEOUT_MS on every sweep.
# Keep that product comfortably below PROBE_SEC; the server refuses to start
# if it exceeds it.
PROBE_COUNT=5
PROBE_TIMEOUT_MS=1000

PRESENCE_SEC=120
SPEEDTEST_MIN=180

# ---------------------------------------------------------------------------
# Probe targets
# ---------------------------------------------------------------------------

PROBE_INTERNET=1.1.1.1,8.8.8.8
PROBE_DNS_NAMES=google.com,mtn.ng

# Leave empty unless you have a Nigerian host you know answers ICMP. Find one
# with `tracert mtn.ng` and pick the last hop that replies consistently. This
# splits "MTN broke" from "an international transit link broke".
PROBE_LOCAL_NG=

# Usually the ONT is also the gateway, in which case leave this empty and it
# is detected from the routing table.
PROBE_GATEWAY=

# ---------------------------------------------------------------------------
# Presence
# ---------------------------------------------------------------------------

# Pings the whole /24 to populate the ARP cache before reading it. Without
# this, presence detection reports an almost empty house on a quiet network.
PRESENCE_SWEEP=1
LAN_SUBNET=192.168.100.1
PRESENCE_OFFLINE_AFTER_SEC=600

# ---------------------------------------------------------------------------
# Mains vs battery
# ---------------------------------------------------------------------------

# Is the machine running this monitor plugged into the same battery pack or
# UPS as the router?
#
# This single flag decides how much can be known. Left at 0 - the monitor is on
# the wall socket - the monitor dies at the same instant the light does, so
# every cut is reconstructed afterwards from the router's uptime counter. That
# still proves whether the Wi-Fi survived, but it cannot see the minute the
# pack gave out, because nothing was awake to watch.
#
# Set it to 1 and every transition is watched live. Putting a Pi or an old
# phone on the same pack as the router is the one change that makes this exact.
POWER_MONITOR_ON_BATTERY=0

# Probe sweeps a new power state must persist for before it is recorded. One
# dropped ping should not enter the household power log as a blackout.
POWER_CONFIRM_SAMPLES=2

# Slack when comparing two computed boot times, seconds. The router reports
# whole seconds and is polled a minute apart, so the same boot lands a few
# seconds off each time; anything closer than this is treated as one boot.
POWER_BOOT_DRIFT_SEC=180

# Send a notification once the router has been on the pack this long. 0 is off.
POWER_BATTERY_WARN_MIN=20

# ---------------------------------------------------------------------------
# Your plan, for the "am I getting what I pay for" comparison
# ---------------------------------------------------------------------------

PLAN_DOWN_MBPS=0
PLAN_UP_MBPS=0

# Monthly cap in GB. 0 means uncapped.
USAGE_CAP_GB=0
BILLING_CYCLE_DAY=1
TZ_NAME=Africa/Lagos

# Path to the Ookla CLI. Without it, throughput falls back to a plain HTTP
# transfer, which needs nothing installed but is less precise - and is not the
# number MTN support will recognise.
SPEEDTEST_BIN=speedtest
SPEEDTEST_ENABLED=1

# ---------------------------------------------------------------------------
# Alerts - all optional, all off unless configured
# ---------------------------------------------------------------------------

# This is what replaces a native app's push notifications. Install the ntfy app
# on every phone in the house, subscribe to one topic, and put its URL here.
# Pick an unguessable topic name: anyone who knows it can read your alerts.
NTFY_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=

ALERT_COOLDOWN_MIN=15
ALERT_NEW_DEVICE=1
ALERT_OPTICAL_DRIFT=1
ALERT_USAGE_THRESHOLD=0.8

# ---------------------------------------------------------------------------
# Guest Wi-Fi QR code
# ---------------------------------------------------------------------------

# Only used to draw the QR code in the app. Leave empty to hide that card.
WIFI_SSID=
WIFI_PASSWORD=
WIFI_SECURITY=WPA

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

PORT=8477
HOST=0.0.0.0

# A TLS certificate and its key, in PEM. Both or neither.
#
# This is what makes the dashboard installable on a phone. A browser only
# registers a service worker on a secure origin, and http://192.168.x.x is not
# one - so over plain http, "Add to home screen" gives a browser shortcut
# rather than the app and nothing is ever cached for offline. Leave these empty
# if you front the app with `tailscale serve`, which terminates TLS itself.
TLS_CERT_FILE=
TLS_KEY_FILE=

# Leave empty for LAN-only plus Tailscale, where the tailnet is the auth
# boundary. Set a passphrase if you expose this port more widely.
ACCESS_CODE=

DB_FILE=
RAW_RETENTION_DAYS=14
ROLLUP_RETENTION_DAYS=730

LOG_LEVEL=info
